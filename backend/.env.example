# SOLARA Backend Configuration Example
PROJECT_NAME="SOLARA Solar Energy CRM API"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL in production)
DATABASE_URL=postgresql+psycopg2://postgres:postgres_your_password@localhost:5432/solar_crm

# JWT Security
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required before seeding a fresh database; use a dev password such as admin123.
SEED_ADMIN_PASSWORD=admin123

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Session & Token Lifetimes
ACCESS_TOKEN_EXPIRE_HOURS=8
ACCESS_TOKEN_EXPIRE_REMEMBER_ME_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ACCOUNT_ACTIVATION_TOKEN_EXPIRE_HOURS=24

# Rate Limiting
AUTH_RATE_LIMIT=5/minute

# Email & Notification Settings
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@solara.com
SMTP_PASSWORD=your_smtp_password
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@solara.com
FRONTEND_URL=http://localhost:5173

