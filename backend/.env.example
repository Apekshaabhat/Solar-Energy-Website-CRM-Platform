# SOLARA Backend Configuration Example
PROJECT_NAME="SOLARA Solar Energy CRM API"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL in production)
DATABASE_URL=postgresql+psycopg2://postgres:postgres_your_password@localhost:5432/solar_crm

# JWT Security
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required when explicitly creating the initial administrator. Use a unique
# password of at least 12 characters with uppercase, lowercase, and a digit.
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_ADMIN_PASSWORD

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Session & Token Lifetimes
ACCESS_TOKEN_EXPIRE_HOURS=8
ACCESS_TOKEN_EXPIRE_REMEMBER_ME_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ACCOUNT_ACTIVATION_TOKEN_EXPIRE_HOURS=24

# Rate Limiting
AUTH_RATE_LIMIT=5/minute

# Email & Notification Settings
EMAIL_BACKEND=console
# For Gmail, create a Google App Password and use the same Gmail address for
# SMTP_USER and EMAILS_FROM_EMAIL. Never use your regular Gmail password.
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
# SMTP_USER=your.name@gmail.com
# SMTP_PASSWORD=your-16-character-google-app-password
# EMAILS_FROM_EMAIL=your.name@gmail.com
FRONTEND_URL=http://localhost:5173
